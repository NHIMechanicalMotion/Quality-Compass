# ==============================================================================
# Odoo Quality Telemetry Sync — Environment Configuration
# NHI Mechanical Motion LLC (NHIMM)
#
# Copy this file to `.env` in the project root or `/opt/quality-compass/.env`
# and fill in your credentials.
#
# DO NOT COMMIT THE ACTUAL `.env` FILE TO GIT.
# ==============================================================================

# Odoo ERP Configuration
ODOO_URL="https://odoo.nhi-mfg.com"
ODOO_DB="nhimm"
ODOO_USER="odoo-sync@nhi-mfg.com"
ODOO_API_KEY="your_odoo_api_key_or_password"

# Supabase Quality Compass Database Configuration (jggdqmygudsiueaiqzcn)
# SUPABASE_URL: Project URL from Supabase Project Settings -> API
SUPABASE_URL="https://jggdqmygudsiueaiqzcn.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: The "service_role" secret (bypasses RLS for sync writes)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"
